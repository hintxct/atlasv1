# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ne-logistics
# For production use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/ne-logistics

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your-openweathermap-api-key

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# WebSocket
SOCKET_CORS_ORIGIN=http://localhost:3000

# GPS Update Interval (milliseconds)
GPS_UPDATE_INTERVAL=5000

# Route Engine
RISK_THRESHOLD_HIGH=65
RISK_THRESHOLD_MEDIUM=30
